+/// Returns true if links under the mouse should be detected. While a
+/// program captures the mouse, detection needs a modifier that bypasses
+/// capture: shift when the program does not capture it, or super, which
+/// mouse reports cannot encode.
+fn mouseLinksActive(self: *const Surface) bool {
+    return mouseLinksActiveFor(
+        self.io.terminal.flags.mouse_event,
+        self.mouse.mods,
+        self.mouseShiftCapture(false),
+    );
+}
+
+fn mouseLinksActiveFor(
+    mouse_event: terminal.MouseEvent,
+    mods: input.Mods,
+    shift_capture: bool,
+) bool {
+    return mouse_event == .none or mods.super or
+        (mods.shift and !shift_capture);
+}
+
+test "mouse link activation under mouse capture" {
+    const testing = std.testing;
+
+    // Without capture, links are active regardless of modifiers.
+    try testing.expect(mouseLinksActiveFor(.none, .{}, true));
+
+    // Under capture, super bypasses capture because mouse reports cannot
+    // encode it; shift only bypasses capture when it is not itself captured.
+    try testing.expect(mouseLinksActiveFor(.any, .{ .super = true }, true));
+    try testing.expect(mouseLinksActiveFor(.any, .{ .shift = true }, false));
+    try testing.expect(!mouseLinksActiveFor(.any, .{ .shift = true }, true));
+    try testing.expect(!mouseLinksActiveFor(.any, .{}, false));
+    try testing.expect(!mouseLinksActiveFor(.any, .{ .ctrl = true }, false));
+}
+
