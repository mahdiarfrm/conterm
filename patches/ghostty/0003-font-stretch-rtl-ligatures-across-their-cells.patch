+    /// Stretches each glyph of an RTL run that stands for letters in more
+    /// than one cell, such as the lam-alef ligature, across those cells.
+    /// CoreText attributes such a glyph to its first letter only, so the
+    /// cells of the letters it absorbed would be left empty and read as a
+    /// space inside the word. Expects `cell_buf` still in output order,
+    /// parallel to `cell_string_index`.
+    fn stretchLigatures(
+        self: *Shaper,
+        alloc: Allocator,
+        run_cells: u16,
+    ) !void {
+        const codepoints = self.run_state.codepoints.items;
+        const cells = self.cell_buf.items;
+        const starts = self.cell_string_index.items;
+        assert(cells.len == starts.len);
+
+        // A glyph's letters run from its own string index up to the next
+        // glyph's, in logical order.
+        const sorted = try alloc.dupe(usize, starts);
+        std.mem.sort(usize, sorted, {}, std.sort.asc(usize));
+
+        var occupied = try std.DynamicBitSetUnmanaged.initEmpty(alloc, run_cells);
+        for (cells) |cell| {
+            if (cell.x < run_cells) occupied.set(cell.x);
+        }
+
+        for (cells, starts) |*cell, start| {
+            // First glyph start past this one.
+            var lo: usize = 0;
+            var hi: usize = sorted.len;
+            while (lo < hi) {
+                const mid = lo + (hi - lo) / 2;
+                if (sorted[mid] <= start) lo = mid + 1 else hi = mid;
+            }
+
+            // Letters drawn with more than one glyph are left as placed.
+            if (lo >= 2 and sorted[lo - 2] == start) continue;
+
+            const end = if (lo < sorted.len) sorted[lo] else codepoints.len;
+
+            var min_cluster: u32 = std.math.maxInt(u32);
+            var max_cluster: u32 = 0;
+            for (codepoints[start..end]) |entry| {
+                // Padding that keeps indices aligned with the UTF-16 string.
+                if (entry.codepoint == 0) continue;
+                min_cluster = @min(min_cluster, entry.cluster);
+                max_cluster = @max(max_cluster, entry.cluster);
+            }
+            if (min_cluster >= max_cluster or max_cluster >= run_cells) continue;
+
+            const span = max_cluster - min_cluster + 1;
+            if (span > std.math.maxInt(u3)) continue;
+
+            // Only claim cells that no other glyph is drawn in.
+            const free = for (@as(usize, min_cluster)..@as(usize, max_cluster) + 1) |c| {
+                if (c != cell.x and occupied.isSet(c)) break false;
+            } else true;
+            if (!free) continue;
+
+            cell.x = @intCast(min_cluster);
+            cell.x_offset = 0;
+            cell.stretch_cells = @intCast(span);
+        }
+    }
+
